# Copy this to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars to git.

# Required secrets
db_password          = "change-me-strong-password"
jwt_secret           = "change-me-at-least-32-random-chars"
platform_groq_key    = "gsk_..."          # free key at console.groq.com — default LLM
platform_claude_key  = "sk-ant-api03-..." # optional fallback
google_client_id     = "123456789.apps.googleusercontent.com"
google_client_secret = "GOCSPX-..."

# Optional
platform_sarvam_key  = ""
domain_name          = "singularraritylabs.com"
subdomain            = "intervue"   # full URL: intervue.singularraritylabs.com
environment          = "prod"
aws_region           = "ap-south-1"
