# Sarvam AI API key — get from https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# App URLs (defaults for local Docker)
APP_URL=http://localhost:3000
API_URL=http://localhost:8080

# Postgres (defaults match docker-compose.local.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_interview
DB_USER=postgres
DB_PASSWORD=postgres

# Demo tenant credentials (created by seed_data.py)
DEMO_EMAIL=demo@techventure.in
DEMO_PASSWORD=DemoPass2026!

# Output
OUTPUT_DIR=output
